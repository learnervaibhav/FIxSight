# Copy to app/core/.env (the backend only reads that location; docker compose reads it too).
# Everything is optional except DATABASE_URL for local (non-Docker) runs.

# Local runs only. Docker compose overrides this with its own Postgres container.
DATABASE_URL=postgresql+psycopg2://fixsight_user:password@localhost:5432/fixsight_db

# Gemini explanations (without it, deterministic rule-based explanations are used)
GOOGLE_API_KEY=
GOOGLE_MODEL_NAME=gemini-2.5-flash

# Twilio, needed only for "Simulation – Real". ALERT_SMS_TO must be a number verified in your Twilio account (trial).
# Sender: a Twilio phone number OWNED by this account (TWILIO_FROM_NUMBER), or a Messaging Service
# that has at least one number (TWILIO_MESSAGING_SERVICE_SID, MG..., preferred when set).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
ALERT_SMS_TO=

# Max real SMS per simulation run (protects your Twilio balance)
SIM_REAL_SMS_LIMIT=10

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fixsight
